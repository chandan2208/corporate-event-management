# Server
PORT=5000
NODE_ENV=development
# Optional bind address; 127.0.0.1 keeps the dev server off the LAN.
# Leave unset on Render.
HOST=127.0.0.1

# PostgreSQL Database
# DATABASE_URL is used by BOTH the app and node-pg-migrate, and takes
# precedence over the DB_* variables below when set. SSL via `sslmode`:
#   Render internal URL (same region): no sslmode
#   Render external URL / Neon:        ?sslmode=require
#   Supabase (Session pooler, port 5432 — Render has no IPv6, so not the
#   direct db.<ref>.supabase.co host, and not the 6543 transaction pooler,
#   which breaks the migration tool's advisory lock):
#     ?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/corporate_event_db

# Optional fallback when DATABASE_URL is NOT set (local development only).
# DB_SSL=true enables non-verifying SSL in this mode.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corporate_event_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false

# Max pooled connections (free Postgres tiers allow few connections).
DB_POOL_MAX=10

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS — frontend origin(s), comma-separated, no trailing slash.
# The FIRST one is also used in certificate verification links.
CLIENT_URL=http://localhost:5173

# Rate limiting (Phase 12) — requests allowed per 15-minute window, per IP.
# All optional; sensible defaults are used if unset. See
# src/middleware/rateLimiter.js for the documented in-memory-store
# limitation (not distributed-safe across multiple instances).
RATE_LIMIT_AUTH=20
RATE_LIMIT_REFRESH=60
RATE_LIMIT_CHECKIN=300
RATE_LIMIT_FEEDBACK=30
RATE_LIMIT_CERTIFICATE=30
# Phase 15 — email verification limiters (optional; defaults shown).
# verify-email: per IP per 15 min, then per email address per 15 min.
RATE_LIMIT_VERIFY_EMAIL=20
RATE_LIMIT_VERIFY_EMAIL_PER_EMAIL=10
# resend-verification: per IP per 15 min, then per email address per 60 min.
RATE_LIMIT_RESEND_VERIFICATION=10
RATE_LIMIT_RESEND_VERIFICATION_PER_EMAIL=5

# Email delivery (Phase 15 — email verification codes).
# PLACEHOLDERS ONLY. Never commit real credentials. On Render, set these in
# the backend service's Environment tab — never in the frontend (no VITE_
# prefix), never in GitHub.
#
# EMAIL_PROVIDER: "smtp" (default, Nodemailer) or "brevo" (HTTPS API).
#   NOTE: Render FREE web services block outbound SMTP on ports 25/465/587.
#   On a free instance use EMAIL_PROVIDER=brevo, or an SMTP relay on port
#   2525. Paid instances can use any SMTP port. Production uses brevo.
EMAIL_PROVIDER=brevo

# --- SMTP (EMAIL_PROVIDER=smtp) ---
EMAIL_HOST=
EMAIL_PORT=
# "true" for implicit TLS (usually port 465); "false" for STARTTLS (587/2525).
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
# Optional. Defaults to true when NODE_ENV=production and EMAIL_SECURE=false
# (refuse to send unless the connection upgrades to TLS).
EMAIL_REQUIRE_TLS=

# --- Brevo HTTPS API (EMAIL_PROVIDER=brevo) ---
# Brevo -> SMTP & API -> API Keys -> "Generate a new API key" (starts with
# xkeysib-). Backend only — never a VITE_ variable.
EMAIL_API_KEY=

# Sender shown to users, e.g. Corporate Event Management <no-reply@yourdomain.com>
# (must be a sender/domain verified with your email provider).
EMAIL_FROM=

# Optional. Secret used to HMAC verification codes at rest. If unset, a key
# is derived from JWT_SECRET. If set, use a long random string.
EMAIL_VERIFICATION_SECRET=

# Initial admin account (used ONLY by the one-time `npm run seed:admin` script,
# never by the public /api/auth/register endpoint)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@corporate-event.com
ADMIN_PASSWORD=change_this_before_seeding
